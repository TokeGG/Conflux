{
  "name": "conflux",
  "version": "0.1.5",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "engines": { "node": ">=22 <25" },
  "workspaces": ["shared", "client"],
  "scripts": {
    "typecheck": "tsc -p shared --noEmit && tsc -p client --noEmit",
    "test": "tsx --test \"shared/test/**/*.test.ts\" \"client/test/**/*.test.ts\"",
    "dev": "npm -w client run dev",
    "build": "npm -w client run build",
    "bump": "tsx scripts/bump.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
