{
  // Cloudflare Worker with static assets: serves the Vite build and runs worker/index.ts for /api/*. The name must match the Cloudflare project name.
  "name": "conflux",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./client/dist",
    "binding": "ASSETS",
    // only /api/* wakes the script; the game files are served straight from the assets
    "run_worker_first": ["/api/*"]
  },
  // reserved owner names (comma separated); the owner code itself is a dashboard secret, OWNER_CODE
  "vars": { "OWNER_NAMES": "toke" },
  // accounts, sessions and shared tuning (see api/README.md)
  "kv_namespaces": [{ "binding": "CONFLUX_KV", "id": "1b5ae26e570448c6aeb5a5e2135c469f" }]
}
