{
  // Cloudflare Worker with static assets: serves the Vite build and runs worker/index.ts for /api/*. The name must match the Cloudflare project name.
  "name": "conflux",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./client/dist",
    "binding": "ASSETS",
    // only /api/* wakes the script; the game files are served straight from the assets
    "run_worker_first": ["/api/*"]
  }
  // Add after creating the KV namespace (see api/README.md):
  // "kv_namespaces": [{ "binding": "CONFLUX_KV", "id": "<namespace id>" }]
}
